# MCP tokens and connection strings (example placeholders only)
# Copy required keys into your local .env (never commit real values).

# GitHub
MCP_GITHUB_TOKEN=replace_with_github_token

# Slack
MCP_SLACK_BOT_TOKEN=replace_with_slack_bot_token

# Sentry
MCP_SENTRY_TOKEN=replace_with_sentry_token
MCP_SENTRY_ORG=replace_with_org_slug
MCP_SENTRY_PROJECT=replace_with_project_slug

# Postgres (read-only role)
MCP_POSTGRES_URL=postgresql://mcp_readonly_user:password@host:5432/payswap_db

# Redis (read-only ACL user where supported by deployment)
MCP_REDIS_URL=redis://mcp_readonly_user:password@host:6379/0

# Fetch allowlist
MCP_FETCH_ALLOWED_HOSTS=docs.cashfree.com,developer.mobikwik.com,www.npci.org.in

# Optional
MCP_TIME_DEFAULT_TZ=Asia/Kolkata
