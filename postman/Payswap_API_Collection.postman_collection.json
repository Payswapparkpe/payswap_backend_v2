{
  "info": {
    "name": "Payswap - All APIs",
    "description": "Payswap Portal, API v2, Euronet BBPS, Mobikwik BBPS. Variables: base_url, service_id, api_key, csrftoken. Portal: login at signin first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "service_id", "value": "1" },
    { "key": "vendor_euronet", "value": "euronet" },
    { "key": "vendor_mobikwik", "value": "mobikwik" },
    { "key": "api_key", "value": "" },
    { "key": "csrftoken", "value": "" }
  ],
  "item": [
    {
      "name": "Portal - Auth",
      "item": [
        {
          "name": "Login (get session)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "X-CSRFToken", "value": "{{csrftoken}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "" },
                { "key": "password", "value": "" },
                { "key": "csrfmiddlewaretoken", "value": "{{csrftoken}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/signin/" },
            "description": "Login as admin/super. First GET {{base_url}}/signin/ in browser, copy csrftoken from cookie or page, set in collection variable. Then run this with username/password. Postman will store session cookie for subsequent Portal requests."
          }
        }
      ]
    },
    {
      "name": "Portal - BBPS Test (Euronet)",
      "item": [
        {
          "name": "1. Balance Enquiry",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/services/{{service_id}}/bbps-test/balance/?vendor={{vendor_euronet}}" }
          }
        },
        {
          "name": "2. Get Billers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/services/{{service_id}}/bbps-test/billers/?vendor={{vendor_euronet}}&category=" }
          }
        },
        {
          "name": "3. Operators (Excel)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/services/{{service_id}}/bbps-test/operators/?vendor={{vendor_euronet}}&category=" }
          }
        },
        {
          "name": "4. Fetch Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRFToken", "value": "{{csrftoken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operator_id\": \"BILLER_ID\",\n  \"customer_id\": \"CONSUMER_ID\",\n  \"subscriber_id\": \"\",\n  \"vendor\": \"euronet\"\n}"
            },
            "url": { "raw": "{{base_url}}/services/{{service_id}}/bbps-test/fetch-bill/" }
          }
        },
        {
          "name": "5. Pay Bill",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRFToken", "value": "{{csrftoken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operator_id\": \"BILLER_ID\",\n  \"customer_id\": \"CONSUMER_ID\",\n  \"amount\": \"100.00\",\n  \"ref_id\": \"EUR_REF_123\",\n  \"subscriber_id\": \"\",\n  \"vendor\": \"euronet\"\n}"
            },
            "url": { "raw": "{{base_url}}/services/{{service_id}}/bbps-test/pay-bill/" }
          }
        },
        {
          "name": "6. Payment Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/services/{{service_id}}/bbps-test/status/?ref_id=REF_ID&vendor={{vendor_euronet}}" }
          }
        }
      ]
    },
