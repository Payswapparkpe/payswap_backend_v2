# Copy to `.env` for local runs (see README). CI does not require this file for analyze/test.
# Trailing slash avoids Dio turning `.../api` + `auth/...` into `.../apiauth/...`
API_BASE_URL=http://localhost:8000/api/
# Android emulator reaching host Django:
# API_BASE_URL=http://10.0.2.2:8000/api/
# macOS / iOS simulator (same machine as Django):
# API_BASE_URL=http://localhost:8000/api/
