# Copy to `.env` for local runs (see README). CI does not require this file for analyze/test.
# Trailing slash avoids Dio turning `.../api` + `auth/...` into `.../apiauth/...`
API_BASE_URL=http://localhost:8000/api/
# Android emulator reaching host Django:
# API_BASE_URL=http://10.0.2.2:8000/api/
# macOS / iOS simulator (same machine as Django):
# API_BASE_URL=http://localhost:8000/api/
#
# Physical iPhone / iPad: localhost is the device, not your Mac — requests will fail with
# connection refused unless you point at the Mac (same Wi‑Fi), e.g.:
# API_BASE_URL=http://192.168.1.42:8000/api/
# Start Django so it accepts LAN connections:  python manage.py runserver 0.0.0.0:8000

# Push notifications (Firebase setup)
# 1) Add `google-services.json` to `android/app/`
# 2) Add `GoogleService-Info.plist` to `ios/Runner/`
# 3) Upload APNs key (.p8) in Firebase console for iOS app
