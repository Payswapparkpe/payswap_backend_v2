# Production env example. Copy to .env on production host; never commit real values.
# See docs/SECRETS_RUNBOOK.md and docs/DEPLOYMENT_CHECKLIST.md.
APP_NAME=Payswap
APP_ENV=production
DEBUG=False
SECRET_KEY=<min-50-chars-from-secure-source>
ALLOWED_HOSTS=api.yourdomain.com,app.yourdomain.com
TIMEZONE=Asia/Kolkata

# Database (use strong password; restrict network)
DATABASE_URL=postgresql://payswap:STRONG_DB_PASSWORD@db-host:5432/payswap_prod

# Redis (use password in production)
REDIS_URL=redis://:REDIS_PASSWORD@redis-host:6379/0
CELERY_BROKER_URL=redis://:REDIS_PASSWORD@redis-host:6379/1
CELERY_RESULT_BACKEND=redis://:REDIS_PASSWORD@redis-host:6379/2
CELERY_TIMEZONE=Asia/Kolkata

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
ENCRYPTION_KEY=<32-plus-chars>
SIGNING_SECRET=<32-plus-chars>
JWT_SIGNING_KEY=<32-plus-chars>
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# ParkPe: partner API key for X-API-Key (create via ensure_parkpe_partner --create-key; inject into frontend at build)
# PARKPE_API_KEY is for reference; actual key lives in DB and is injected into ParkPe frontend (NG_APP_API_KEY etc.)
# PARKPE_API_KEY=

# Vendor keys: set per integration (Cashfree, Kaleyra, Mobikwik, etc.). Never commit.
# See .env.example for full list (CASHFREE_*, KALEYRA_*, MOBIKWIK_*, etc.).

# Email / SMS (production credentials)
KALEYRA_API_KEY=
KALEYRA_SID=
# Microsoft 365: smtp.office365.com:587 + TLS; use app password if MFA enabled
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_DEFAULT_FROM=no-reply@yourdomain.com

# Optional: Sentry, CORS, TRUSTED_PROXY_IPS
SENTRY_ENABLED=True
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
TRUSTED_PROXY_IPS=10.0.0.1
