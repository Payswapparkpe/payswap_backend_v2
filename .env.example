# NEVER commit real credentials. Use placeholders below; set real values in .env (git-ignored).
# If any credential was ever committed or shared, rotate it in the vendor dashboard immediately.
# See docs/SECRETS_RUNBOOK.md for rotation and deployment.
#
# Application
APP_NAME=Payswap
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-minimum-50-characters-long-for-security
ALLOWED_HOSTS=localhost,127.0.0.1
# For LAN testing (phone/tablet on same WiFi): add your machine's LAN IP or use * (e.g. ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.5 or ALLOWED_HOSTS=* for dev only).
# CORS: when DEBUG=True, all origins are allowed (Angular on any port works). For production set explicit origins.
# If you get "Http failure 0" on login: (1) ensure backend is running (e.g. python manage.py runserver),
# (2) ensure frontend apiUrl points to it (e.g. http://localhost:8000/api in environment.ts).
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
TIMEZONE=Asia/Kolkata

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/payswap_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
SIGNING_SECRET=your-32-character-signing-secret-here
JWT_SIGNING_KEY=your-32-character-jwt-signing-key-here
# Access token: 900 = 15 min session timeout (ParkPe API). Increase for longer sessions.
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=86400

# API Explorer: pre-fill API Key at /api-explorer/ and for test commands (test_all_api_responses, test_api_and_check_logs)
# Copy this to .env and set your partner API key (from Reseller > API Keys or create_internal_api_keys)
EXPLORER_DEFAULT_API_KEY=
# Optional: auto-include extra security headers on every API Explorer request (JSON object)
# Example: EXPLORER_DEFAULT_HEADERS={"X-Security-Key":"...","X-Client-Id":"..."}
EXPLORER_DEFAULT_HEADERS=

# SMS / OTP - Kaleyra India (shared by Portal MFA and ParkPe auth/scanner OTP)
# Get credentials from Kaleyra dashboard. Use India region (api.in.kaleyra.io).
KALEYRA_API_KEY=your-kaleyra-api-key
KALEYRA_SID=your-kaleyra-sid
# Base URL: India region only. Do NOT include /v1 (code adds it). Use api.in.kaleyra.io not api.kaleyra.io
KALEYRA_BASE_URL=api.in.kaleyra.io
# Sender ID (DLT header). Must match DLT registration (default PYSWAP).
# KALEYRA_HEADER_PAYSWAP=PYSWAP
# OTP template: DLT Reg_otp (ID 1007640321725099860). Body must match DLT exactly - see DLT/template-data.csv
KALEYRA_OTP_TEMPLATE_ID=1007640321725099860

# Email – Microsoft 365 / Outlook (default for all app mail including voucher queue when ParkPe SMTP is unset)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-mailbox@yourdomain.com
SMTP_PASSWORD=your-app-password-or-mailbox-password
SMTP_USE_TLS=True
SMTP_DEFAULT_FROM=your-mailbox@yourdomain.com

# Optional: separate SMTP for ParkPe voucher emails only. Omit to use Microsoft settings above.
# SMTP_HOST_Parkpe=
# SMTP_PORT_Parkpe=587
# SMTP_USER_Parkpe=
# SMTP_PASSWORD_Parkpe=
# SMTP_USE_TLS_Parkpe=true
# SMTP_DEFAULT_FROM_Parkpe=
# PARKPE_SMTP_SSL_VERIFY=true
# Gift Voucher Brand ID for ParkPe (VoucherX). Create a brand in VoucherX with api_identifier=PARKPE, then set its ID here.
# PARKPE_VOUCHER_BRAND_ID=1
# When true, ParkPe rejects payments until billing address (line1, state, 6-digit PIN) is saved on the profile.
# PARKPE_REQUIRE_BILLING_ADDRESS=false
# data.gov.in Pincode API (for ParkPe address lookup by pincode). Get key from https://data.gov.in
# DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
# DATA_GOV_IN_PINCODE_RESOURCE_URL=https://api.data.gov.in/resource/5c2f62fe-5afa-4119-a499-fec9d604d5bd

# Instantpay API (SANDBOX or PRODUCTION)
INSTANTPAY_CLIENT_ID=your-instantpay-client-id
INSTANTPAY_CLIENT_SECRET=your-instantpay-client-secret
INSTANTPAY_ENCRYPTION_KEY=your-instantpay-encryption-key
INSTANTPAY_AUTH_CODE=your-instantpay-x-ipay-auth-code
INSTANTPAY_ENDPOINT_IP=your-public-endpoint-ip
INSTANTPAY_REPORT_BANK_PROFILE_ID=0
INSTANTPAY_REPORT_ACCOUNT_NUMBER=your-linked-account-number
INSTANTPAY_ENVIRONMENT=SANDBOX

# Unified Notification Center
NOTIFICATIONS_ENABLED=True
NOTIFICATIONS_PUSH_ENABLED=False
NOTIFICATIONS_ROLLOUT_PERCENT=100
NOTIFICATIONS_RATE_LIMIT_PER_USER=50

# ParkPe Connect risk controls
CONNECT_CALL_MAX_PER_USER_HOUR=8
CONNECT_CALL_MAX_PER_PHONE_HOUR=12
CONNECT_CALL_MAX_PER_OWNER_HOUR=15
CONNECT_CALL_MAX_PER_FINGERPRINT_HOUR=10
CONNECT_CALL_MAX_UNIQUE_QR_PER_HOUR=5
CONNECT_CHAT_MAX_PER_USER_HOUR=80
CONNECT_CHAT_MAX_PER_THREAD_HOUR=35
CONNECT_CHAT_MAX_PER_RECIPIENT_HOUR=45
CONNECT_CHAT_MAX_PER_FINGERPRINT_HOUR=100
CONNECT_CHAT_MAX_BODY_LENGTH=500

# ============================================================================
# CASHFREE VERIFICATION (also used for ParkPe Vehicle RC – registration certificate)
# ============================================================================
CASHFREE_API_KEY=your-cashfree-verification-api-key
CASHFREE_API_SECRET=your-cashfree-verification-api-secret
# File paths: relative to backend/ when you run `python manage.py` from `backend/`
CASHFREE_PUBLIC_KEY_PATH=./Cashfree/your_public_key.pem
# SANDBOX or PRODUCTION – verification APIs (Vehicle RC, etc.) use this; default PRODUCTION
CASHFREE_VERIFICATION_ENVIRONMENT=PRODUCTION
# Optional: use separate keys for Verification (Vehicle RC). If not set, CASHFREE_API_KEY/SECRET are used.
# Get keys from: https://merchant.cashfree.com/verificationsuite/developers/api-keys
# CASHFREE_VERIFICATION_API_KEY=
# CASHFREE_VERIFICATION_API_SECRET=

# ============================================================================
# Cashfree Payment Gateway (PG)
# ============================================================================
CASHFREE_PG_CLIENT_ID=your-cashfree-pg-client-id
CASHFREE_PG_CLIENT_SECRET=your-cashfree-pg-client-secret
CASHFREE_PG_ENVIRONMENT=SANDBOX
# Easy Split vendor id for Hub “Vendor Pool Balance” (GET /pg/easy-split/vendors/{vendor_id}/balances)
# CASHFREE_PG_EASY_SPLIT_VENDOR_ID=
# Optional: CASHFREE_PG_PARTNER_KEY=
# Optional: CASHFREE_PG_CLIENT_SIGNATURE=
# Optional: CASHFREE_PG_PARTNER_MERCHANT_ID=
# Parkpe backend (PG whitelist flow): secret for register-order and webhook-relay. Send as X-Parkpe-Backend-Key or Bearer.
# PARKPE_BACKEND_SECRET=your-parkpe-backend-secret

# (Razorpay PG removed; ParkPe uses Cashfree only.)

# AWS S3
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=payswap-documents
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# Logging
LOG_LEVEL=INFO
PAYSWAP_LOG_LEVEL=DEBUG
PAYSWAP_LOG_TEXT_FORMAT=False
PAYSWAP_LOG_ENABLE_API_CONTEXT=True
PAYSWAP_MASK_SHOW_START=4
PAYSWAP_MASK_SHOW_END=3
PAYSWAP_LOG_RETENTION_DAYS=30
PAYSWAP_LOG_DIR=logs

# Sentry (Optional)
SENTRY_ENABLED=False
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Mobikwik BBPS (Bharat Bill Payment System) – New API (UAT/Onboarding docs)
# Token Generation + Encrypted payload (encryptedSessionKey, encryptedPayload, keyVersion, iv)
# Get credentials from Mobikwik BBPS onboarding (API Kit). Optional - enable when ready.
#
# UAT/testing host: https://alpha3.mobikwik.com  |  B2B production host: https://rapi-b2b.mobikwik.com
# Partner dashboard (balance, transactions): https://rapi-b2b.mobikwik.com/partner/index.html#/login
# RSA public key: use PEM from onboarding email; set MOBIKWIK_BBPS_KEY_VERSION per attached README (not the email body).
# Rollout: Mobikwik typically asks for ~10 test transactions across operators before full traffic.
MOBIKWIK_BBPS_ENABLED=False
MOBIKWIK_BBPS_CLIENT_ID=
MOBIKWIK_BBPS_CLIENT_SECRET=
MOBIKWIK_BBPS_MERCHANT_ID=
MOBIKWIK_BBPS_API_KEY=
MOBIKWIK_BBPS_SECRET_KEY=
MOBIKWIK_BBPS_BASE_URL=https://alpha3.mobikwik.com
MOBIKWIK_BBPS_ENVIRONMENT=UAT
# Encryption required per RT-Recharge doc (request body must be encrypted). Use public key from mobikwik_public_key_*.zip
MOBIKWIK_BBPS_USE_ENCRYPTION=True
# Token API (/recharge/v1/verify/retailer): plain JSON {clientId, clientSecret} per Mobikwik UAT Postman — NOT the same as MOBIKWIK_BBPS_USE_ENCRYPTION (that encrypts View Bill / Pay only).
# If Hub shows "Encrypted token body" + 1308, you have TOKEN_USE_ENCRYPTION=True somewhere — set False and restart; optional belt-and-suspenders: MOBIKWIK_BBPS_TOKEN_PLAIN_JSON=True
MOBIKWIK_BBPS_TOKEN_USE_ENCRYPTION=False
# MOBIKWIK_BBPS_TOKEN_PLAIN_JSON=False
# Copy PEM to backend/Mobikwik/public_key.pem (gitignored). Path is relative to backend/ (BASE_DIR). Wrong path (e.g. only zip folder name) is ignored after log — code falls back to Mobikwik/public_key.pem if that file exists.
MOBIKWIK_BBPS_PUBLIC_KEY_PATH=Mobikwik/public_key.pem
MOBIKWIK_BBPS_KEY_VERSION=1.0
# Naive token expiryTime from Mobikwik token API is interpreted in this IANA timezone (default: IST)
# MOBIKWIK_BBPS_TOKEN_EXPIRY_TIMEZONE=Asia/Kolkata
# Seconds before Mobikwik expiryTime to mint a new token (default 600 = 10 min; fewer mints vs ~100/day cap)
# MOBIKWIK_BBPS_TOKEN_REFRESH_BUFFER_SECONDS=600
# Max Token API successes counted per IST calendar day (align with Mobikwik ~100/day)
# MOBIKWIK_BBPS_TOKEN_MAX_MINTS_PER_DAY=100
# Set PLAIN_JSON_UAT=True only if Mobikwik UAT allows plain body (default False = use encryption in UAT too)
MOBIKWIK_BBPS_PLAIN_JSON_UAT=False
# Balance Check (matches Mobikwik UAT Postman): encrypted JSON body uses memberId from onboarded email when set.
# MOBIKWIK_BBPS_MEMBER_ID=your-onboarded-email@example.com
# If you have no MEMBER_ID, optional MOBIKWIK_BBPS_MERCHANT_ID sends {"merchantId": ...} instead.
# MOBIKWIK_BBPS_MERCHANT_ID=your-merchant-id-from-onboarding
# Validation & Recharge: agentId (required in UAT per Postman – e.g. MK01MK01INB523643654)
MOBIKWIK_BBPS_AGENT_ID=
MOBIKWIK_BBPS_PUBLIC_KEY=
# UAT/onboarding: set True to log full request/response (sanitized) and cURL per API to LogEntry. Required for UAT checklist (items 1-14). Off in production.
MOBIKWIK_BBPS_UAT_VERBOSE_LOG=True
# UAT me actual request/response values log me dikhane ke liye (cn, refId, etc mask nahi)
# MOBIKWIK_BBPS_LOG_SANITIZE=False
# Retry once on timeout or 5xx after 2s. Both attempts logged when UAT_VERBOSE_LOG is on.
# MOBIKWIK_BBPS_RETRY_ON_FAILURE=True
# HTTP timeout (seconds) for Mobikwik API – view_bill/recharge can be slow on UAT; default 60
# MOBIKWIK_BBPS_REQUEST_TIMEOUT=60
# Mobikwik credentials (get from Mobikwik onboarding)
MOBIKWIK_UID=your-mobikwik-uid
MOBIKWIK_PSWD=your-mobikwik-password
MOBIKWIK_ENDPOINT=https://rapi.mobikwik.com/
MOBIKWIK_SALT=your-mobikwik-salt

# Euronet BBPS (Bharat Connect / EFT APME) – Single endpoint EnService
# UAT: https://epayuat.eftapme.com/ENServiceAES256/API/EnService
EURONET_BBPS_ENABLED=False
EURONET_BBPS_BASE_URL=https://epayuat.eftapme.com/ENServiceAES256/API
EURONET_BBPS_MERCHANT_CODE=your-euronet-merchant-code
EURONET_BBPS_USERNAME=your-euronet-username
EURONET_BBPS_PASSWORD=your-euronet-password
EURONET_BBPS_STORE_CODE=your-euronet-store-code
EURONET_BBPS_CHANNEL_CODE=INT
EURONET_BBPS_AGENT_ID=your-euronet-agent-id
EURONET_BBPS_SALT=your-euronet-salt
EURONET_BBPS_ENCRYPTION_KEY=your-euronet-encryption-key

# PayPoint AEPS (Aadhaar Enabled Payment System)
# Docs: https://docs.paypointindia.co.in/api/paypoint-aeps-api/paypoint/overview
# UserCode, Password, IdentificationCode & Key from PayPoint; first three are encrypted via Encrypt API before each request. IP whitelist required.
PAYPOINT_AEPS_ENABLED=False
PAYPOINT_AEPS_BASE_URL=https://api.paypointindia.co.in
PAYPOINT_AEPS_USER_CODE=
PAYPOINT_AEPS_PASSWORD=
PAYPOINT_AEPS_IDENTIFICATION_CODE=
PAYPOINT_AEPS_KEY=
PAYPOINT_AEPS_ENVIRONMENT=UAT

# PayPoint DMT (Domestic Money Transfer)
# Docs: https://docs.paypointindia.co.in/api/paypoint-dmt-api/dmt-api/overview
# Same Encrypt API as AEPS; UserCode, Password, IdentificationCode encrypted before each request. IP whitelist required.
PAYPOINT_DMT_ENABLED=False
PAYPOINT_DMT_BASE_URL=https://api.paypointindia.co.in
PAYPOINT_DMT_USER_CODE=
PAYPOINT_DMT_PASSWORD=
PAYPOINT_DMT_IDENTIFICATION_CODE=
PAYPOINT_DMT_KEY=
PAYPOINT_DMT_ENVIRONMENT=UAT

# Leegality (e-Sign / Document) – config reads LEGALITY_AUTH_TOKEN and LEGALITY_PRIVATE_SALT (not AuthToken/PrivateSalt)
LEGALITY_AUTH_TOKEN=
LEGALITY_PRIVATE_SALT=

# Trusted proxy IPs (VAPT-002/003). Comma-separated LB/WAF IPs or CIDRs. When REMOTE_ADDR is in this list, client IP is taken from X-Forwarded-For.
# TRUSTED_PROXY_IPS=10.0.0.1,172.16.0.0/12
TRUSTED_PROXY_IPS=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

