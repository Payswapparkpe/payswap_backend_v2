# Application
APP_NAME=Payswap
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-minimum-50-characters-long-for-security
ALLOWED_HOSTS=localhost,127.0.0.1
# CORS: when DEBUG=True, all origins are allowed (Angular on any port works). For production set explicit origins.
# If you get "Http failure 0" on login: (1) ensure backend is running (e.g. python manage.py runserver),
# (2) ensure frontend apiUrl points to it (e.g. http://localhost:8000/api in environment.ts).
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
TIMEZONE=Asia/Kolkata

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/payswap_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
SIGNING_SECRET=your-32-character-signing-secret-here
JWT_SIGNING_KEY=your-32-character-jwt-signing-key-here
# Access token: 900–3600 (15–60 min) recommended for production
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=86400

# API Explorer: pre-fill API Key at /api-explorer/ and for test commands (test_all_api_responses, test_api_and_check_logs)
# Copy this to .env and set your partner API key (from Reseller > API Keys or create_internal_api_keys)
EXPLORER_DEFAULT_API_KEY=
# Optional: auto-include extra security headers on every API Explorer request (JSON object)
# Example: EXPLORER_DEFAULT_HEADERS={"X-Security-Key":"...","X-Client-Id":"..."}
EXPLORER_DEFAULT_HEADERS=

# SMS / OTP - Kaleyra (required for OTP on mobile)
# Get credentials from Kaleyra dashboard. Without these, OTP will not be sent.
KALEYRA_API_KEY=your-kaleyra-api-key
KALEYRA_SID=your-kaleyra-sid
KALEYRA_BASE_URL=https://api.kaleyra.io/v1
# OTP template ID (DLT-approved). Default: 1007141008198087301
# DLT Template: "Dear User, Your one time password for Payswap registration is {#var#}. Please do not share this OTP any one. Powered by PAYSWAP."
# KALEYRA_OTP_TEMPLATE_ID=1007640321725099860

# Email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=True
SMTP_DEFAULT_FROM=no-reply@payswap.in

# Email SMTP Parkpe (for voucher system – Zoho etc.)
SMTP_HOST_Parkpe=smtppro.zoho.in
SMTP_PORT_Parkpe=587
SMTP_USER_Parkpe=noreply@parkpe.in
SMTP_PASSWORD_Parkpe=
SMTP_USE_TLS_Parkpe=true
SMTP_DEFAULT_FROM_Parkpe=noreply@parkpe.in
# Set to false if voucher email fails with SSL on macOS (dev): PARKPE_SMTP_SSL_VERIFY=false
PARKPE_SMTP_SSL_VERIFY=false
# Gift Voucher Brand ID for ParkPe (VoucherX). Create a brand in VoucherX with api_identifier=PARKPE, then set its ID here.
# PARKPE_VOUCHER_BRAND_ID=1

# Instantpay API (SANDBOX or PRODUCTION)
INSTANTPAY_CLIENT_ID=your-instantpay-client-id
INSTANTPAY_CLIENT_SECRET=your-instantpay-client-secret
INSTANTPAY_ENCRYPTION_KEY=your-instantpay-encryption-key
INSTANTPAY_ENVIRONMENT=SANDBOX

# ============================================================================
# CASHFREE VERIFICATION
# ============================================================================
CASHFREE_API_KEY=CF580638D5R1M6UG19RC73EH5E40
CASHFREE_API_SECRET=cfsk_ma_prod_c3d2956cee74101911e80c3d4ac9d0ac_4d84857b
CASHFREE_PUBLIC_KEY_PATH=./Cashfree/accountId_59940_public_key.pem

# ============================================================================
# Cashfree Payment Gateway (PG)
# ============================================================================
CASHFREE_PG_CLIENT_ID=TEST10065975143fe57d21e3d5a397e157956001
CASHFREE_PG_CLIENT_SECRET=TESTa09cd12dcd3f92aa2645121bdf6aedaf74922b09
CASHFREE_PG_ENVIRONMENT=SANDBOX
# Optional: CASHFREE_PG_PARTNER_KEY=
# Optional: CASHFREE_PG_CLIENT_SIGNATURE=
# Optional: CASHFREE_PG_PARTNER_MERCHANT_ID=

# (Razorpay PG removed; ParkPe uses Cashfree only.)

# AWS S3
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=payswap-documents
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# Logging
LOG_LEVEL=INFO
PAYSWAP_LOG_LEVEL=DEBUG
PAYSWAP_LOG_TEXT_FORMAT=False
PAYSWAP_LOG_ENABLE_API_CONTEXT=True
PAYSWAP_MASK_SHOW_START=4
PAYSWAP_MASK_SHOW_END=3
PAYSWAP_LOG_RETENTION_DAYS=30
PAYSWAP_LOG_DIR=logs

# Sentry (Optional)
SENTRY_ENABLED=False
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Mobikwik BBPS (Bharat Bill Payment System) – New API (UAT/Onboarding docs)
# Token Generation + Encrypted payload (encryptedSessionKey, encryptedPayload, keyVersion, iv)
# Get credentials from Mobikwik BBPS onboarding (API Kit). Optional - enable when ready.
MOBIKWIK_BBPS_ENABLED=False
MOBIKWIK_BBPS_CLIENT_ID=
MOBIKWIK_BBPS_CLIENT_SECRET=
MOBIKWIK_BBPS_MERCHANT_ID=
MOBIKWIK_BBPS_API_KEY=
MOBIKWIK_BBPS_SECRET_KEY=
MOBIKWIK_BBPS_BASE_URL=https://alpha3.mobikwik.com
MOBIKWIK_BBPS_ENVIRONMENT=UAT
# Optional: encrypted request body (use Mobikwik public key from mobikwik_public_key_*.zip)
MOBIKWIK_BBPS_USE_ENCRYPTION=False
MOBIKWIK_BBPS_PUBLIC_KEY=
MOBIKWIK_BBPS_PUBLIC_KEY_PATH=Mobikwik/public_key.pem
MOBIKWIK_BBPS_KEY_VERSION=1.0
# Mobikwik credentials FOR Live
MOBIKWIK_UID=collection@payswap.in
MOBIKWIK_PSWD=Afkr241
MOBIKWIK_ENDPOINT="https://rapi.mobikwik.com/"
MOBIKWIK_SALT=5DYJS4686C79M48QT68M6QLDFFT2TY25

# Euronet BBPS (Bharat Connect / EFT APME) – Single endpoint EnService
# UAT: https://epayuat.eftapme.com/ENServiceAES256/API/EnService
EURONET_BBPS_ENABLED=False
EURONET_BBPS_BASE_URL=https://epayuat.eftapme.com/ENServiceAES256/API
EURONET_BBPS_MERCHANT_CODE=PAY
EURONET_BBPS_USERNAME=PAY_01
EURONET_BBPS_PASSWORD=PAY_01
EURONET_BBPS_STORE_CODE=PAY_01
EURONET_BBPS_CHANNEL_CODE=INT
EURONET_BBPS_AGENT_ID=EU01EU02000000000001
EURONET_BBPS_SALT=Os3dcl82
EURONET_BBPS_ENCRYPTION_KEY=

# PayPoint AEPS (Aadhaar Enabled Payment System)
# Docs: https://docs.paypointindia.co.in/api/paypoint-aeps-api/paypoint/overview
# UserCode, Password, IdentificationCode & Key from PayPoint; first three are encrypted via Encrypt API before each request. IP whitelist required.
PAYPOINT_AEPS_ENABLED=False
PAYPOINT_AEPS_BASE_URL=https://api.paypointindia.co.in
PAYPOINT_AEPS_USER_CODE=
PAYPOINT_AEPS_PASSWORD=
PAYPOINT_AEPS_IDENTIFICATION_CODE=
PAYPOINT_AEPS_KEY=
PAYPOINT_AEPS_ENVIRONMENT=UAT

# PayPoint DMT (Domestic Money Transfer)
# Docs: https://docs.paypointindia.co.in/api/paypoint-dmt-api/dmt-api/overview
# Same Encrypt API as AEPS; UserCode, Password, IdentificationCode encrypted before each request. IP whitelist required.
PAYPOINT_DMT_ENABLED=False
PAYPOINT_DMT_BASE_URL=https://api.paypointindia.co.in
PAYPOINT_DMT_USER_CODE=
PAYPOINT_DMT_PASSWORD=
PAYPOINT_DMT_IDENTIFICATION_CODE=
PAYPOINT_DMT_KEY=
PAYPOINT_DMT_ENVIRONMENT=UAT

# Leegality (e-Sign / Document) – config reads LEGALITY_AUTH_TOKEN and LEGALITY_PRIVATE_SALT (not AuthToken/PrivateSalt)
LEGALITY_AUTH_TOKEN=
LEGALITY_PRIVATE_SALT=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True