# Application
APP_NAME=Payswap
APP_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-minimum-50-characters-long-for-security
ALLOWED_HOSTS=localhost,127.0.0.1
TIMEZONE=Asia/Kolkata

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/payswap_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
SIGNING_SECRET=your-32-character-signing-secret-here
JWT_SIGNING_KEY=your-32-character-jwt-signing-key-here
JWT_ACCESS_TOKEN_LIFETIME=300
JWT_REFRESH_TOKEN_LIFETIME=86400

# SMS - Kaleyra
KALEYRA_API_KEY=your-kaleyra-api-key
KALEYRA_SID=your-kaleyra-sid
KALEYRA_BASE_URL=https://api.kaleyra.io/v1

# Email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=True
SMTP_DEFAULT_FROM=no-reply@payswap.in

# AWS S3
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=payswap-documents
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# Logging
LOG_LEVEL=INFO
PAYSWAP_LOG_LEVEL=DEBUG
PAYSWAP_LOG_TEXT_FORMAT=False
PAYSWAP_LOG_ENABLE_API_CONTEXT=True
PAYSWAP_MASK_SHOW_START=4
PAYSWAP_MASK_SHOW_END=3
PAYSWAP_LOG_RETENTION_DAYS=30
PAYSWAP_LOG_DIR=logs

# Sentry (Optional)
SENTRY_ENABLED=False
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True