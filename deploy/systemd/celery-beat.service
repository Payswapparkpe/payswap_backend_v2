# Celery Beat – Payswap / ParkPe (if using periodic tasks)
# Install: sudo cp deploy/systemd/celery-beat.service /etc/systemd/system/
#         Edit WorkingDirectory/ExecStart if app lives elsewhere.
#         sudo systemctl daemon-reload && sudo systemctl enable celery-beat && sudo systemctl start celery-beat
# Logs:   journalctl -u celery-beat -f

[Unit]
Description=Celery Beat - Payswap
After=network.target redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/payswap/backend
Environment="PATH=/var/www/payswap/venv/bin"
ExecStart=/var/www/payswap/venv/bin/celery -A core beat -l info
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=celery-beat

[Install]
WantedBy=multi-user.target
